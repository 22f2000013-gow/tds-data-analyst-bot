# Copy to .env locally; on the host set these as environment variables.
BOT_TOKEN=            # from @BotFather
AIPIPE_TOKEN=         # OpenAI-compatible API key (aipipe.org / OpenAI / OpenRouter)
MODEL=google/gemini-3.1-pro-preview
MODEL_BASE_URL=https://aipipe.org/openai/v1
BASE_URL=https://your-service.onrender.com   # public URL of THIS service
LOG_PATH=/tmp/run.jsonl
# FORCE_WRAP=1        # always reply {"answer":...,"log_url":...} even if the msg omits log_url
